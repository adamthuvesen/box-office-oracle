# Core runtime
ENVIRONMENT=dev
PROJECT_NAME=box-office

# AWS (docs + code default to eu-north-1)
AWS_REGION=eu-north-1
AWS_DEFAULT_REGION=eu-north-1
AWS_ACCOUNT_ID=123456789012
AWS_OIDC_ROLE_ARN=arn:aws:iam::123456789012:role/box-office-github-oidc
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/box-office-dev-sagemaker-execution-role

# SageMaker / S3 artifacts
AWS_S3_BUCKET=box-office-dev-sagemaker-artifacts-123456789012
# Inference API reads S3_BUCKET_NAME; keep aligned with AWS_S3_BUCKET
S3_BUCKET_NAME=box-office-dev-sagemaker-artifacts-123456789012
# Legacy name used in docs/older scripts
SAGEMAKER_BUCKET=box-office-dev-sagemaker-artifacts-123456789012

# Model registry (derived from PROJECT_NAME + ENVIRONMENT if omitted)
MODEL_REGISTRY_GROUP_NAME=box-office-dev-box-office-models

# Snowflake (dbt + pipeline)
SNOWFLAKE_ACCOUNT=your-account
SNOWFLAKE_USER=your-user
SNOWFLAKE_PRIVATE_KEY_PATH=keys/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=BOX_OFFICE
# Which role runs what (see docs/development.md):
#   DBT_RUNNER        -> pipeline + dbt (owns STAGING/ML_TRAINING/FEATURE_STORE,
#                        read-only on RAW). This is the value to use here.
#   BOX_OFFICE_LOADER -> RAW dataset loads via scripts/load_dataset_to_snowflake.py
#                        (run that script with SNOWFLAKE_ROLE=BOX_OFFICE_LOADER).
#   ACCOUNTADMIN      -> administration only, never in the runtime path.
SNOWFLAKE_ROLE=DBT_RUNNER
SNOWFLAKE_SCHEMA_RAW=RAW
SNOWFLAKE_SCHEMA_STAGING=STAGING
SNOWFLAKE_SCHEMA_ML_TRAINING=ML_TRAINING
SNOWFLAKE_SCHEMA_FEATURE_STORE=FEATURE_STORE

# Prefect (optional for Prefect Cloud)
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/your-account-id/workspaces/your-workspace-id
PREFECT_API_KEY=your-prefect-api-key

# External data/LLM utilities (optional)
TMDB_API_TOKEN=your-tmdb-api-token
API_KEY=your-inference-api-key
OPENAI_API_KEY=your-openai-api-key
