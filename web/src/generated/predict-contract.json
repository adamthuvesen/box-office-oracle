{
  "genres": [
    "Action",
    "Adventure",
    "Animation",
    "Comedy",
    "Crime",
    "Drama",
    "Family",
    "Fantasy",
    "Horror",
    "Mystery",
    "Romance",
    "Science Fiction",
    "Thriller",
    "War",
    "Western"
  ],
  "ip_tiers": [
    {
      "label": "Original / no IP",
      "value": 5
    },
    {
      "label": "Nominal IP (adaptation, minor property)",
      "value": 4
    },
    {
      "label": "Known source work",
      "value": 3
    },
    {
      "label": "Strong franchise / brand",
      "value": 2
    },
    {
      "label": "Top-tier pre-sold IP",
      "value": 1
    }
  ],
  "predict_request": {
    "additionalProperties": false,
    "description": "Input schema for prediction requests.",
    "properties": {
      "actors": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": [],
        "description": "List of main actors",
        "title": "Actors"
      },
      "budget": {
        "description": "Production budget in USD",
        "minimum": 0,
        "title": "Budget",
        "type": "number"
      },
      "director": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "Unknown",
        "description": "Director name",
        "title": "Director"
      },
      "genre": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ],
        "description": "Movie genre(s)",
        "title": "Genre"
      },
      "ip_tier": {
        "default": 5,
        "description": "Pre-sold IP tier at release (1 = strongest, 5 = no IP)",
        "maximum": 5,
        "minimum": 1,
        "title": "Ip Tier",
        "type": "integer"
      },
      "is_franchise_followup": {
        "default": false,
        "description": "Whether any strictly-earlier film exists in the collection",
        "title": "Is Franchise Followup",
        "type": "boolean"
      },
      "mpaa": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "Not Rated",
        "description": "MPAA rating",
        "title": "Mpaa"
      },
      "prior_franchise_gross": {
        "default": 0.0,
        "description": "Sum of worldwide gross (USD) of strictly-earlier films in the same collection; 0 for a first film or no collection",
        "minimum": 0,
        "title": "Prior Franchise Gross",
        "type": "number"
      },
      "production_company": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "Unknown",
        "description": "Production company",
        "title": "Production Company"
      },
      "release_month": {
        "description": "Release month (1-12)",
        "maximum": 12,
        "minimum": 1,
        "title": "Release Month",
        "type": "integer"
      },
      "release_year": {
        "description": "Release year",
        "maximum": 2030,
        "minimum": 1900,
        "title": "Release Year",
        "type": "integer"
      },
      "return_confidence": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": true,
        "description": "Return confidence interval",
        "title": "Return Confidence"
      },
      "runtime": {
        "description": "Movie runtime in minutes",
        "maximum": 500,
        "minimum": 1,
        "title": "Runtime",
        "type": "number"
      }
    },
    "required": [
      "budget",
      "runtime",
      "genre",
      "release_month",
      "release_year"
    ],
    "title": "PredictionRequest",
    "type": "object"
  },
  "predict_response": {
    "properties": {
      "model_id": {
        "description": "Model identifier used for prediction",
        "title": "Model Id",
        "type": "string"
      },
      "model_version": {
        "description": "Model version used",
        "title": "Model Version",
        "type": "integer"
      },
      "prediction": {
        "description": "Predicted box office gross in USD",
        "title": "Prediction",
        "type": "number"
      },
      "prediction_interval_heuristic": {
        "anyOf": [
          {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Heuristic interval (lower, upper) around the point prediction. NOT a calibrated confidence interval \u2014 derived from a fixed percentage of the predicted value, not from model uncertainty.",
        "title": "Prediction Interval Heuristic"
      },
      "processing_time_ms": {
        "description": "Processing time in milliseconds",
        "title": "Processing Time Ms",
        "type": "number"
      },
      "timestamp": {
        "description": "Prediction timestamp",
        "title": "Timestamp",
        "type": "string"
      }
    },
    "required": [
      "prediction",
      "model_id",
      "model_version",
      "timestamp",
      "processing_time_ms"
    ],
    "title": "PredictionResponse",
    "type": "object"
  }
}
