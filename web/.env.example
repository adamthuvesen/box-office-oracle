# Live inference API, used by /api/model-info (the "In the projector now"
# card on /model). Both values are server-side only — never sent to the browser.

# Base URL of the deployed inference API, with trailing slash, e.g.
# https://abc123.execute-api.eu-west-1.amazonaws.com/prod/
INFERENCE_API_URL=

# API key sent as the X-API-Key header.
INFERENCE_API_KEY=
